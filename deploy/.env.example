# Copy to ".env" next to docker-compose.prod.yml and fill in. Never commit ".env".
# Generate secrets with:  openssl rand -base64 36

# Public address (no https://). DNS "A" records for DOMAIN and www.DOMAIN must point at this server.
DOMAIN=invest.example.uz
# Address for certificate notices from Let's Encrypt.
ACME_EMAIL=admin@example.uz

POSTGRES_PASSWORD=
S3_ACCESS_KEY=investmap
S3_SECRET_KEY=
# At least 32 random characters. Changing it later signs everyone out and breaks old request tracking links.
AUTH_SECRET=

# First start only: creates the first super administrator (password: 10+ characters, letter and digit).
# Remove both lines after the first successful start.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# Outgoing mail, e.g. smtps://user:password@smtp.example.uz:465. Without it messages wait in the queue.
SMTP_URL=
# Sender shown on outgoing mail; the address must belong to your domain (set up SPF/DKIM there so mail is not marked as spam).
MAIL_FROM=InvestMap <no-reply@invest.example.uz>

# Backups: how many days of database dumps to keep, and the hour (UTC) they run. 21:00 UTC = 02:00 in Tashkent.
BACKUP_KEEP_DAYS=14
BACKUP_HOUR_UTC=21
