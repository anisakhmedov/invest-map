{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:studio": "prisma studio",
    "db:seed": "tsx prisma/seed.ts",
    "test:int": "vitest run --config vitest.int.config.mts",
    "db:seed:demo": "tsx prisma/seed-demo.ts",
    "copy:maplibre": "node scripts/copy-maplibre-worker.mjs",
    "predev": "node scripts/copy-maplibre-worker.mjs",
    "prebuild": "node scripts/copy-maplibre-worker.mjs",
    "postinstall": "node scripts/copy-maplibre-worker.mjs",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@prisma/client": "^6.19.3",
    "maplibre-gl": "^6.15.0",
    "next": "16.4.3",
    "nodemailer": "^10.2.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "terra-draw": "^1.38.0",
    "terra-draw-maplibre-gl-adapter": "^1.5.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "packageManager": "pnpm@10.28.1",
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
